{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fiesta-st-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiesta_st",
      "database_id": "51cedab1-7b9c-41ba-a76d-f67a9b309ff7"
    }
  ],
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "3766d6baa89148ca8c8230819aa10fe5" }
  ],
  "vars": {
    "SOURCE": "mock",
    "FUEL_TYPE": "95",
    "PROVINCE": "43"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true }
}
